# Copy to ~/.hindsight/.env (or .env in a repo checkout). Without a Gemini key search is keyword-only.
# HINDSIGHT_MODEL=claude-opus-5-5           # claude -p model for extraction + reconcile
# HINDSIGHT_CLAUDE=claude-proxy           # Claude CLI or wrapper to run (default: claude)
# HINDSIGHT_HOME=/path/to/data              # default: ~/.hindsight
# GRANOLA_API_KEY=grn_...                   # prefer Keychain: security add-generic-password -s hindsight-granola -a granola -w
# GEMINI_API_KEY=AQ....                     # prefer Keychain: security add-generic-password -s hindsight-gemini -a gemini -w
